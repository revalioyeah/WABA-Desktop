<Window x:Class="WABA.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warung Auto Bag Assistant PC — v0.4.1 Guided Order Queue"
        Width="820" Height="820" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WARUNG AUTO BAG ASSISTANT" FontSize="23" FontWeight="Bold"/>
                <TextBlock Text="PC DESKTOP COMPANION  •  PHASE 4.1 GUIDED ORDER QUEUE"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="1,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#183B30" BorderBrush="#2C7458"
                    BorderThickness="1" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="WINDOWS DESKTOP" FontSize="11" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="01  GAME CONNECTION" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                            <TextBlock Text="Pilih jendela Google Play Games" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                            <ComboBox x:Name="TargetWindowComboBox" DisplayMemberPath="Title"
                                      Background="#202C3D" Foreground="#F7FAFC"
                                      SelectionChanged="TargetWindowComboBox_SelectionChanged"/>
                            <Button Content="↻  Refresh daftar jendela" Click="RefreshWindows_Click"/>
                            <TextBlock x:Name="TargetDetailsText" Text="Belum ada jendela dipilih"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="02  SCREEN CAPTURE" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="Capture mengambil area client yang terlihat di monitor. Jangan minimalkan atau tutupi jendela game."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="▣  Ambil satu frame" Click="CaptureOnce_Click"/>
                            <Button x:Name="LivePreviewButton" Content="▶  Mulai live preview" Click="LivePreview_Click"/>
                            <TextBlock x:Name="CaptureInfoText" Text="Belum ada frame"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="03  MANUAL INPUT TEST" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="Koordinat relatif terhadap client area game (bukan koordinat seluruh monitor)."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                            <Grid Margin="0,6,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="X (client)" FontSize="11"/>
                                    <TextBox x:Name="CoordinateXTextBox" Text="500"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y (client)" FontSize="11"/>
                                    <TextBox x:Name="CoordinateYTextBox" Text="400"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="⊙  Test klik kiri" Background="#65452A"
                                    BorderBrush="#A87942" Click="TestClick_Click"/>
                            <TextBlock Text="PERINGATAN: tombol ini mengirim klik mouse sungguhan ke game."
                                       Foreground="#F0C18B" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="04  SMART ORDER RECOGNITION" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="ROI panel pesanan dalam persentase ukuran client game. Default H=45% agar daftar panjang ikut masuk crop. Sesuaikan sampai seluruh papan pesanan terlihat; jangan memotong baris terbawah."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="X %" FontSize="10"/>
                                    <TextBox x:Name="OrderRoiXTextBox" Text="40"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Y %" FontSize="10"/>
                                    <TextBox x:Name="OrderRoiYTextBox" Text="17"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="W %" FontSize="10"/>
                                    <TextBox x:Name="OrderRoiWidthTextBox" Text="23"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="H %" FontSize="10"/>
                                    <TextBox x:Name="OrderRoiHeightTextBox" Text="45"/>
                                </StackPanel>
                            </Grid>
                            <Button Content="◎  Scan panel pesanan" Click="ScanOrderPanel_Click"/>
                            <CheckBox x:Name="AutoOrderScanCheckBox"
                                      Content="Pantau perubahan panel &amp; scan otomatis"
                                      Foreground="#DCE6F1" FontSize="11" Margin="0,5,0,5"
                                      Checked="AutoOrderScanCheckBox_Checked"
                                      Unchecked="AutoOrderScanCheckBox_Unchecked"/>
                            <TextBlock x:Name="OrderEngineText" Text="Memeriksa Windows OCR..."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBlock x:Name="OrderScanStatusText" Text="Belum ada pemindaian."
                                       Foreground="#65D6A3" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="05  SMART ITEM DETECTION" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                            <TextBlock Text="OCR membaca label rak sebagai observasi. Katalog 37 slot dipertahankan saat satu scan gagal; koordinat referensi tidak diganti oleh hasil OCR sementara." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,7"/>
                            <Button x:Name="DetectShelfItemsButton" Content="◎  Scan &amp; verifikasi katalog" Click="DetectShelfItems_Click"/>
                            <TextBlock x:Name="ShelfDetectionEngineText" Text="Memeriksa Windows OCR..." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <TextBlock x:Name="ShelfDetectionStatusText" Text="Belum ada deteksi lokasi barang." Foreground="#65D6A3" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,5"/>
                            <TextBlock x:Name="CatalogStateText" Text="Memuat stable catalog..." Foreground="#8FC7FF" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,5"/>
                            <TextBlock Text="Legenda preview: hijau/oranye = terbaca OCR saat ini; biru = dipertahankan dari baseline." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,7"/>
                            <CheckBox x:Name="ConfirmCatalogCoordinatesCheckBox"
                                      Content="Saya sudah memeriksa posisi marker pada preview"
                                      Foreground="#DCE6F1" FontSize="10" Margin="0,0,0,7"
                                      Checked="ConfirmCatalogCoordinatesCheckBox_Checked"
                                      Unchecked="ConfirmCatalogCoordinatesCheckBox_Unchecked"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                <Button x:Name="LockCatalogButton" Content="Kunci katalog" Click="LockCatalog_Click" Margin="0,0,7,0" Padding="10,6"/>
                                <Button Content="Kalibrasi ulang" Click="RecalibrateCatalog_Click" Padding="10,6" Background="#65452A"/>
                            </StackPanel>
                            <TextBox x:Name="ShelfDetectionOutputText" IsReadOnly="True" Text="Hasil deteksi lokasi produk akan tampil di sini." TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#080C12" BorderBrush="#34445A" Foreground="#DCE6F1" FontSize="9" Padding="6" Height="150"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="06  PESANAN OTOMATIS" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Background="#26364A" BorderBrush="#40536D"
                                        BorderThickness="1" CornerRadius="10" Padding="8,3">
                                    <TextBlock Text="PERLU KONFIRMASI" FontSize="8" FontWeight="Bold" Foreground="#AFC8E8"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Ikuti dua langkah di bawah. WABA tidak akan mengklik barang sebelum kamu memeriksa rencana dan menekan tombol jalankan."
                                       Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,9"/>

                            <Border Background="#111A27" BorderBrush="#34445A" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,9">
                                <StackPanel>
                                    <TextBlock Text="PERSIAPAN SEBELUM MEMBUAT RENCANA" FontSize="9" FontWeight="Bold" Foreground="#8FC7FF" Margin="0,0,0,5"/>
                                    <TextBlock Text="1. Bagian 05: scan katalog dan pastikan 37/37 slot tersedia. Periksa marker pada preview. Jika katalog berstatus terkunci, cukup centang konfirmasi marker. Jika kalibrasi terbuka, lakukan 3 scan sampai tombol Kunci katalog aktif, lalu kunci."
                                               FontSize="10" Foreground="#DCE6F1" TextWrapping="Wrap" Margin="0,2"/>
                                    <TextBlock Text="2. Pastikan game menampilkan pesanan pelanggan yang ingin dikerjakan. Bagian 04 dapat dipakai untuk memeriksa hasil OCR secara manual."
                                               FontSize="10" Foreground="#DCE6F1" TextWrapping="Wrap" Margin="0,2"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="LANGKAH 1  •  SUSUN RENCANA" FontSize="10" FontWeight="Bold" Foreground="#DCE6F1" Margin="0,0,0,3"/>
                            <TextBlock Text="Tekan satu tombol ini. WABA mengambil frame terbaru, membaca panel pesanan, lalu langsung menyusun daftar barang dan jumlah yang masih harus diambil."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <Button x:Name="BuildOrderPlanButton" Content="①  Baca pesanan &amp; buat rencana" Click="ScanAndBuildOrderPlan_Click"
                                    Background="#2A4664" BorderBrush="#52769D" Padding="11,9"/>

                            <Border Background="#0B111A" BorderBrush="#40536D" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,6,0,8">
                                <StackPanel>
                                    <TextBlock Text="STATUS RENCANA" FontSize="8" FontWeight="Bold" Foreground="#8FA6C0" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="OrderQueuePlanStatusText"
                                               Text="Belum siap. Selesaikan verifikasi katalog di bagian 05, tampilkan pesanan pelanggan, lalu tekan tombol biru di atas."
                                               Foreground="#AFC8E8" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="DAFTAR BARANG YANG AKAN DIAMBIL" FontSize="9" FontWeight="Bold" Foreground="#DCE6F1" Margin="0,0,0,4"/>
                            <TextBox x:Name="OrderQueuePlanOutputText" IsReadOnly="True"
                                     Text="Belum ada rencana.&#10;&#10;Tekan 'Baca pesanan &amp; buat rencana'. WABA akan membaca pesanan terbaru dan menampilkan daftar barang di sini."
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     Background="#080C12" BorderBrush="#34445A"
                                     Foreground="#DCE6F1" FontSize="10"
                                     Padding="8" Height="145"/>

                            <TextBlock Text="LANGKAH 2  •  PERIKSA DAN JALANKAN" FontSize="10" FontWeight="Bold" Foreground="#DCE6F1" Margin="0,9,0,3"/>
                            <TextBlock Text="Periksa nama produk dan jumlah pada daftar. Jika benar, tekan tombol hijau. WABA akan mengirim klik mouse sungguhan ke game. Rencana berlaku maksimal 20 detik."
                                       FontSize="9" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <Button x:Name="ExecuteOrderQueueButton" Content="▶  Jalankan rencana (klik sungguhan)"
                                    Click="ExecuteOrderQueue_Click" IsEnabled="False"
                                    Background="#245B45" BorderBrush="#3C9A70" Padding="11,9" Margin="0,2,0,3"/>
                            <Button x:Name="StopOrderQueueButton" Content="■  Hentikan proses"
                                    Click="StopOrderQueue_Click" IsEnabled="False"
                                    Background="#65452A" BorderBrush="#A87942" Padding="10,7"/>

                            <Border Background="#33291E" BorderBrush="#775A36" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,7,0,0">
                                <TextBlock Text="Catatan keselamatan: maksimal 20 klik per rencana, jeda 105 ms. Jika rencana kedaluwarsa atau pesanan berubah, tekan kembali 'Baca pesanan &amp; buat rencana'. Dialog pelanggan, tips, dan minigame belum ditangani otomatis. Hentikan proses jika tampilan game berubah atau tertutup. Periksa hasil pengambilan di game."
                                           Foreground="#F0C18B" FontSize="9" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="07  PHASE STATUS" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="Window enumeration" Width="178" Foreground="#9BA9BA" FontSize="11"/>
                                <TextBlock Text="READY" Foreground="#65D6A3" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="Visible capture" Width="178" Foreground="#9BA9BA" FontSize="11"/>
                                <TextBlock Text="READY" Foreground="#65D6A3" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="Manual mouse test" Width="178" Foreground="#9BA9BA" FontSize="11"/>
                                <TextBlock Text="MANUAL ONLY" Foreground="#65D6A3" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="Order OCR" Width="178" Foreground="#9BA9BA" FontSize="11"/>
                                <TextBlock Text="PHASE 2 • READY" Foreground="#65D6A3" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="Shelf detection" Width="178" Foreground="#9BA9BA" FontSize="11"/>
                                <TextBlock Text="PHASE 3.3 • STABLE CATALOG" Foreground="#65D6A3" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="Order queue" Width="178" Foreground="#9BA9BA" FontSize="11"/>
                                <TextBlock Text="PHASE 4.1 • GUIDED QUEUE" Foreground="#F0C18B" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="140"/>
                        <RowDefinition Height="115"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="GAME WINDOW PREVIEW" FontWeight="Bold" FontSize="13"/>
                            <TextBlock Text="Live capture • Phase 2 OCR • Phase 3.3 stable catalog • Phase 4.0 queue" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="PreviewStateText" Text="WAITING"
                                   Foreground="{StaticResource MutedBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#080C12" BorderBrush="#34445A" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <Canvas x:Name="DetectionOverlayCanvas" IsHitTestVisible="False" SizeChanged="DetectionOverlayCanvas_SizeChanged"/>
                            <TextBlock x:Name="PreviewPlaceholderText"
                                       Text="Pilih jendela game, lalu tekan Ambil satu frame"
                                       Foreground="#8796A9" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="20"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Background="#111A27" CornerRadius="8" Padding="9" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ORDER PANEL CROP" FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                                <Border Background="#080C12" BorderBrush="#34445A" BorderThickness="1" CornerRadius="5"
                                        Height="88" ClipToBounds="True">
                                    <Image x:Name="OrderCropPreview" Stretch="Uniform"/>
                                </Border>
                                <TextBlock x:Name="OrderScanMetaText" Text="Belum ada crop"
                                           Foreground="{StaticResource MutedBrush}" FontSize="8"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ORDER OCR RESULT" FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                                <TextBox x:Name="OrderScanOutputText" IsReadOnly="True"
                                         Text="Hasil OCR dan parsing pesanan akan tampil di sini."
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="#080C12" BorderBrush="#34445A"
                                         Foreground="#DCE6F1" FontSize="9"
                                         Padding="6" Height="108"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Background="#111A27" CornerRadius="8" Padding="9" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ACTIVITY LOG" FontWeight="Bold" FontSize="10" Margin="0,0,0,5"/>
                            <ListBox x:Name="ActivityLogListBox" Grid.Row="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#C6D2E0" FontSize="9"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatusText" Text="Ready — pilih jendela game untuk memulai."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text=".NET 10  •  WABA PC 0.4.1-guided-order-queue"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>


